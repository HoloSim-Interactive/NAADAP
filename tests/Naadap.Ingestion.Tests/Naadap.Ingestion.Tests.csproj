<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Justification: xUnit (+ Microsoft.NET.Test.Sdk runner glue and
       coverlet.collector for coverage) is the standard .NET test
       framework chosen per DELIV-920/SDD Coding Standards; test-only
       dependency, never referenced by src/ projects. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Naadap.Ingestion\Naadap.Ingestion.csproj" />
  </ItemGroup>

  <!-- Copies the checked-in TP-100/TP-110 fixture set alongside the test
       binaries so integration tests can read it via a relative path without
       depending on the repo root or working directory at test-run time. -->
  <ItemGroup>
    <None Include="..\fixtures\smoke\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures\smoke" />
  </ItemGroup>

</Project>
