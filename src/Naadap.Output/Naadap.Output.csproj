<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Naadap.Core\Naadap.Core.csproj" />
  </ItemGroup>

  <!-- OUT-430's validation-methodology document is authored once in
       docs/VALIDATION_METHODOLOGY.md (the single canonical source, also
       readable directly from the repo as a static submission document) and
       embedded into this assembly so ValidationMethodologyWriter can copy
       it into every run's output bundle without depending on the repo's
       docs/ directory existing next to the published container at runtime.
       No PackageReference needed: System.Text.Json and embedded-resource
       support both ship in the net9.0 BCL/SDK. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\VALIDATION_METHODOLOGY.md" LogicalName="Naadap.Output.ValidationMethodology.md" />
  </ItemGroup>

  <!-- The vehicle knowledge base (gate G5; derived requirements KB-600 to
       KB-630; reopened DELIV-950). Built offline by scripts/kb/build_kb.py
       from scripts/kb/catalog.json and the FY2025 FPDS extract, committed
       under Resources/kb/, and embedded here so it ships inside the image
       with no run-time file or network dependency (NFR-500). Logical names
       are Naadap.Output.kb.<filename>; VehicleKnowledgeBase verifies every
       file against manifest.sha256 before use (KB-630). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\kb\*" LogicalName="Naadap.Output.kb.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
